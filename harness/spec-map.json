{
  "areas": [
    {
      "id": "runner",
      "paths": ["^backend/app/workers/runner/", "^backend/egress/", "^backend/scripts/coldstart"],
      "docs": ["workspace/content/design/14-解析引擎.md", "workspace/content/design/07-平台与Provider.md", "SECURITY.md"],
      "note": "平台阶梯、失败分类与十二字段执行上下文以解析引擎设计为准；不解密、不扩大内容范围。"
    },
    {
      "id": "identity",
      "paths": ["^backend/app/workers/identity/", "^backend/app/workers/runner/engine/identity\\.py$", "^browser-extension/"],
      "docs": ["workspace/content/design/15-平台身份.md", "SECURITY.md"],
      "note": "身份只来自 Chrome 扩展；Cookie 不进入业务数据、日志、队列或 Temporal。"
    },
    {
      "id": "intent",
      "paths": ["^backend/app/services/download", "^backend/app/repositories/downloads/", "^backend/app/workers/download/", "^backend/app/api/routes/(download|inspection|source_discover)"],
      "docs": ["workspace/content/design/06-解析意图.md", "workspace/content/design/13-工作流编排.md"],
      "note": "意图状态机、generation/fence 与 120 秒截止不可绕过；解析归 Temporal，下载归 RabbitMQ。"
    },
    {
      "id": "workflow",
      "paths": ["^backend/app/workers/(main\\.py|outbox/|report/|dlq/|imports/)", "^backend/app/integrations/messaging/"],
      "docs": ["workspace/content/design/13-工作流编排.md", "workspace/content/design/12-可靠性与运行.md"],
      "note": "同一业务只有一个执行所有者；跨存储写入使用 transactional outbox。"
    },
    {
      "id": "analysis",
      "paths": ["^backend/app/workers/analysis/", "^backend/app/services/(analysis|skills)", "^backend/app/integrations/ai_", "^backend/app/repositories/analysis/", "^backend/app/api/routes/(analys|admin_ai)"],
      "docs": ["workspace/content/design/09-AI分析.md", "workspace/content/design/10-报告导出.md", "workspace/content/prd/README.md"],
      "note": "Skill 范围由 PRD 定义；结果未知的模型调用禁止自动重发；Prompt 与原始响应不进普通日志。"
    },
    {
      "id": "imports",
      "paths": ["^backend/app/services/(documents|imports|import_execution|storage_files)", "^backend/app/repositories/(documents|imports|storage_files)/", "^frontend/src/lib/upload/"],
      "docs": ["workspace/content/design/08-内容导入.md"],
      "note": "上传会话与 quarantine 必须过期；删除不做部分删除。"
    },
    {
      "id": "auth",
      "paths": ["^backend/app/services/auth", "^backend/app/repositories/auth/", "^backend/app/api/routes/(auth|native_auth|users)", "^backend/app/core/security/"],
      "docs": ["workspace/content/design/04-身份与会话.md", "SECURITY.md"],
      "note": "Web 只用不透明 HttpOnly Cookie；App 走 /api/app/v1 Bearer 契约，修改需同步 video-app。"
    },
    {
      "id": "admission",
      "paths": ["^backend/app/api/admission\\.py$", "quota"],
      "docs": ["workspace/content/design/05-准入配额与容量.md"],
      "note": "配额在资源创建事务内检查，重放判断先于扣减。"
    },
    {
      "id": "api",
      "paths": ["^backend/app/api/", "^backend/app/schemas/", "^backend/app/main\\.py$"],
      "docs": ["workspace/content/design/03-接口契约.md", "PROJECT.md"],
      "note": "OpenAPI 是唯一契约：改注解或 schema 后执行 frontend 的 pnpm openapi 并提交生成结果。"
    },
    {
      "id": "persistence",
      "paths": ["^backend/sql/", "^backend/app/models/", "^backend/app/repositories/", "^backend/app/core/db\\.py$"],
      "docs": ["PROJECT.md", "workspace/content/design/02-总体架构.md"],
      "note": "schema.sql 是唯一当前态结构，同步更新 ORM 与测试；不建迁移目录。"
    },
    {
      "id": "core",
      "paths": ["^backend/app/core/", "^backend/app/integrations/"],
      "docs": ["PROJECT.md", "workspace/content/design/02-总体架构.md", "workspace/content/design/12-可靠性与运行.md"],
      "note": "运行资源在 lifespan 中创建与释放；导入应用不连接外部服务。"
    },
    {
      "id": "frontend",
      "paths": ["^frontend/"],
      "docs": ["design.md", "PROJECT.md", "workspace/content/design/11-Web体验.md", "frontend/AGENTS.md"],
      "note": "视觉只以 design.md 为准；接口类型直接用 API.*，不设 services/utils/types 聚合层。"
    },
    {
      "id": "runtime",
      "paths": ["^docker-compose", "Dockerfile$", "^\\.github/", "^\\.env\\.example$"],
      "docs": ["workspace/content/design/02-总体架构.md", "workspace/content/design/12-可靠性与运行.md", "CONTRIBUTING.md"],
      "note": "Compose 只启动业务容器并复用宿主基础服务；CI 只跑确定性检查。"
    },
    {
      "id": "workspace",
      "paths": ["^workspace/"],
      "docs": ["AGENTS.md"],
      "note": "文档只写当前规格；PRD 定义范围、设计定义约束、Plan 记录执行证据，同一规格只维护一处并更新目录 README 索引。"
    }
  ],
  "protected": [
    { "pattern": "^frontend/src/api/", "reason": "由 frontend 的 pnpm openapi 从 FastAPI OpenAPI 生成，不手改" },
    { "pattern": "^browser-extension/(manifest|config\\.local)\\.json$", "reason": "由 cookie-source install 生成" },
    { "pattern": "(^|/)\\.env(\\.prod)?$", "reason": "本机环境配置，只能由用户修改" },
    { "pattern": "(^|/)(uv\\.lock|pnpm-lock\\.yaml)$", "reason": "只能由 uv 或 pnpm 更新" },
    { "pattern": "^backend/app/services/analysis/skills/modules/", "reason": "上游 Skill 原样接入，适配放在目录之外" }
  ],
  "forbidden": [
    { "pattern": "^backend/(migrations|alembic)/", "reason": "数据库只维护当前态 backend/sql/schema.sql，不建迁移目录" },
    { "pattern": "^frontend/src/(services|utils|types)/", "reason": "不设 services/utils/types 聚合层，接口类型直接使用 API.*" },
    { "pattern": "(^|/)[^/]*(_v\\d+|V\\d+)\\.(py|ts|tsx|js|mjs)$", "reason": "不使用代际命名，直接修改唯一实现" },
    { "pattern": "^docs/", "reason": "文档统一维护在 workspace/content/" }
  ]
}
