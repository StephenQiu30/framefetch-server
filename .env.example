# Copy this file to .env before starting local services.
# Local business processes use Homebrew PostgreSQL, RabbitMQ, Redis, and MinIO
# on their configured ports. Containers connect through *_HOST / *_PORT.
# Keep real local secrets in .env and never commit it.
# Compose forwards only its declared variables; other settings use application defaults.

TZ=Asia/Shanghai
APP_ENV=development
# Frontend Dockerfile stage: development for Compose Watch, runtime for production.
FRONTEND_BUILD_TARGET=development
FRONTEND_HOST_PORT=8101
# Canonical public origin used by metadata, Open Graph, robots.txt and sitemap.xml.
SITE_URL=http://127.0.0.1:8101
# Only enable on an intentionally public site with a stable canonical domain.
SITE_INDEXABLE=false
TRUSTED_PROXY_CIDRS=["127.0.0.0/8","::1/128"]
# Compose trusts only the frontend's exact address in addition to the proxy list.
# External ingress CIDRs belong in TRUSTED_PROXY_CIDRS; never trust 0.0.0.0/0.
FRONTEND_IPV4_ADDRESS=10.251.0.10
APP_NETWORK_SUBNET=10.251.0.0/24
APP_NETWORK_IP_RANGE=10.251.0.128/25
# Partial JSON overrides; all unlisted keys retain the typed application defaults.
RATE_LIMIT_POLICIES={}
QUOTA_LIMITS={"max_active_per_owner":5,"daily_tasks":50,"daily_bytes":107374182400,"storage_bytes":107374182400,"daily_analysis_attempts":60}
METRICS_ACCESS_KEY=development-metrics-access-key-change-me

EGRESS_PROXY_HOST_PORT=13128

# Reuse existing host services. Set ports and credentials to their actual values.
# Containers use host.docker.internal; host processes use loopback URLs below.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
MINIO_HOST=host.docker.internal
MINIO_PORT=9000

POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=video
DATABASE_URL=postgresql+asyncpg://video:video@127.0.0.1:5432/video

RABBITMQ_ADMIN_USER=video
RABBITMQ_ADMIN_PASS=video
RABBITMQ_VHOST=video
RABBITMQ_API_USER=video-api
RABBITMQ_API_PASS=video-api-secret
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/${RABBITMQ_VHOST}
RABBITMQ_API_URL=amqp://guest:guest@127.0.0.1:5672/${RABBITMQ_VHOST}
# One account for the worker container (Outbox, download, import, report).
RABBITMQ_WORKER_USER=video-worker
RABBITMQ_WORKER_PASS=video-worker-secret
RABBITMQ_DLQ_USER=video-dlq
RABBITMQ_DLQ_PASS=video-dlq-secret
RABBITMQ_DLQ_URL=amqp://guest:guest@127.0.0.1:5672/${RABBITMQ_VHOST}
REDIS_URL=redis://127.0.0.1:6379/0
DOWNLOAD_WORKER_THREADS=4

# 本地导入开关：视频与剧本文档上传默认开启，均可显式关闭。
# 关闭对应导入时，API 不允许创建新的上传任务。
MEDIA_IMPORT_ENABLED=true
DOCUMENT_IMPORT_ENABLED=true
# 仅填写逗号分隔的 exact origin（scheme://host[:port]）；禁止通配符和路径。
# 已有 MinIO 必须由其管理员在实例启动配置中应用此值；业务启动不会修改 MinIO。
MINIO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8101,http://localhost:8101

# MinIO 所有应用进程共用这一组 AK/SK；不要再增加按进程复制的凭据变量。
MINIO_ACCESS_KEY=video-access
MINIO_SECRET_KEY=video-secret-change-me
MINIO_BUCKET=video-artifacts
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_SECURE=false
# 可选：当 Web 在 API/MinIO 同一台开发机运行时，为浏览器单独签发回环地址。
# 原生 App 不发送 local-web 标识，仍使用上方可从手机访问的公共地址。
MINIO_LOCAL_BROWSER_ENDPOINT=127.0.0.1:9000
MINIO_LOCAL_BROWSER_SECURE=false

AUTH_JWT_SECRET=development-jwt-secret-change-me-32-bytes
AUTH_WEB_COOKIE_NAME=video_web_session
# This reserved account receives the administrator role only when registration
# also provides the X-Admin-Bootstrap-Secret header.
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_SECRET=development-admin-bootstrap-secret-change-me
REQUEST_FINGERPRINT_SECRET=development-fingerprint-secret-change-me
URL_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtdXJsLWtleS0zMi1ieXRlcyEhISE=

# Local (non-Compose) media Runner; Compose wires http://session-runner:19100.
# SESSION_RUNNER_BASE_URL=http://127.0.0.1:19100
RUNNER_HMAC_SECRET=development-runner-secret-change-me
# 宿主运行 Runner 时也通过受控 Squid 两个端口，不直接连 Clash。
RUNNER_EGRESS_PROXY=http://127.0.0.1:13128
RUNNER_GLOBAL_EGRESS_PROXY=http://127.0.0.1:13129
EGRESS_GLOBAL_PROXY_HOST_PORT=13129
# 国内已有 ISP/家宽可留空直连；配置时使用 Clash 固定国内节点监听端口。
EGRESS_CN_UPSTREAM_HOST=
EGRESS_CN_UPSTREAM_PORT=7897
# 静态境外 ISP/住宅节点专用 Clash HTTP 监听；未配置降级为 datacenter。
EGRESS_GLOBAL_UPSTREAM_HOST=
EGRESS_GLOBAL_UPSTREAM_PORT=7898
EGRESS_FALLBACK_UPSTREAM_HOST=host.docker.internal
EGRESS_FALLBACK_UPSTREAM_PORT=7897
# Clash 节点/规则改变，即使监听地址未变也必须递增并重建 Runner。
EGRESS_NODE_REVISION=1
# 回显目标必须匹配路由区域，避免宿主按域名分流导致国内出口误报。
RUNNER_CN_EGRESS_IP_ECHO_URL=https://ip.3322.net
RUNNER_GLOBAL_EGRESS_IP_ECHO_URL=https://ipinfo.io/ip
RUNNER_WORKSPACE_ROOT=../tmp/runner-work
RUNNER_MAX_ACTIVE_TASKS=4
# 身份配置：只注入宿主 cookie-source 与 session-runner，API/worker 不持有令牌。
# 在独立的 0600 身份配置文件中设置 COOKIE_SOURCE_TOKEN（至少 32 字节随机 ASCII）。
# Compose 只向 session-runner 注入令牌；不得把宿主配对密钥传入容器。
# COOKIE_SOURCE_TOKEN=<部署者生成的随机令牌>
COOKIE_SOURCE_PORT=19101
# 必须位于 Runner 的私有 tmpfs；目录由启动钩子清理，名称固定 framefetch-identity。
RUNNER_IDENTITY_TMPFS_ROOT=/tmp/framefetch-identity
ARTICLE_DISCOVERY_PROXY_URL=http://127.0.0.1:7897
PEERTUBE_ALLOWED_INSTANCES=[]
ANALYSIS_WORKER_HEARTBEAT_SECONDS=10

# AI Worker 运行在宿主机；模型与线路由 Web Profile 管理。
# 这里只保留宿主机 CLI 二进制路径，未启用第三方 Profile 时固定使用 local-codex。
# 剧本分析还会受 ANALYSIS_ENABLED 总开关约束。
ANALYSIS_ENABLED=true
SCREENPLAY_ANALYSIS_ENABLED=true
ANALYSIS_CODEX_BINARY=codex
ANALYSIS_CLAUDE_BINARY=claude
ANALYSIS_CLAUDE_MAX_TURNS=40
ANALYSIS_FFMPEG_BINARY=ffmpeg
ANALYSIS_FFPROBE_BINARY=ffprobe
# 可选；默认使用系统临时目录。自定义路径必须位于 Git 仓库和 AGENTS.md 管辖目录之外。
# ANALYSIS_WORKSPACE_ROOT=/absolute/path/to/framefetch-analysis
ANALYSIS_MAX_SCREENPLAY_BYTES=2097152
ANALYSIS_SCREENPLAY_SINGLE_CALL_CHARACTERS=120000
ANALYSIS_DATABASE_URL=postgresql+asyncpg://video:video@127.0.0.1:5432/video
ANALYSIS_MINIO_ENDPOINT=127.0.0.1:9000

# 首位管理员可由部署机交互命令 bootstrap_admin 初始化；其他用户注册需真实 SMTP。
# 注册邮箱验证码：启用前配置真实 SMTP；不支持固定验证码或跳过验证。
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Reuse the existing host Temporal service; business Compose does not start it.
TEMPORAL_HOST=host.docker.internal
TEMPORAL_PORT=7233
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=framefetch
