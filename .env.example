# Copy this file to .env before starting local services.
# Local business processes use Homebrew PostgreSQL, RabbitMQ, Redis, and MinIO
# on their standard ports. Docker Compose overrides these endpoints internally.
# Keep real local secrets in .env and never commit it.

TZ=Asia/Shanghai
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8111
FRONTEND_HOST_PORT=8101
# Canonical public origin used by metadata, Open Graph, robots.txt and sitemap.xml.
SITE_URL=http://127.0.0.1:8101
# Only enable on an intentionally public site with a stable canonical domain.
SITE_INDEXABLE=false
REQUEST_MAX_BYTES=262144
REQUEST_TIMEOUT_SECONDS=180
TRUSTED_PROXY_CIDRS=["127.0.0.0/8","::1/128"]
# Compose trusts only the frontend's exact address in addition to the proxy list.
# External ingress CIDRs belong in TRUSTED_PROXY_CIDRS; never trust 0.0.0.0/0.
FRONTEND_IPV4_ADDRESS=10.251.0.10
APP_NETWORK_SUBNET=10.251.0.0/24
APP_NETWORK_IP_RANGE=10.251.0.128/25
# Partial JSON overrides; all unlisted keys retain the typed application defaults.
RATE_LIMIT_POLICIES={}
QUOTA_LIMITS={"max_active_per_owner":5,"daily_tasks":50,"daily_bytes":107374182400,"storage_bytes":107374182400,"daily_analysis_attempts":60}
DOCUMENT_NORMALIZED_MAX_CHARACTERS=2000000
ANALYSIS_REPORT_MAX_BYTES=16777216
METRICS_ACCESS_KEY=development-metrics-access-key-change-me

EGRESS_PROXY_HOST_PORT=13128

# Reuse existing host services. Set ports and credentials to their actual values.
# Containers use host.docker.internal; host processes use loopback URLs below.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
MINIO_HOST=host.docker.internal
MINIO_PORT=9000

POSTGRES_DB=video
POSTGRES_USER=video
POSTGRES_PASSWORD=video
DATABASE_URL=postgresql+asyncpg://video:video@127.0.0.1:5432/video

RABBITMQ_ADMIN_USER=video
RABBITMQ_ADMIN_PASS=video
RABBITMQ_VHOST=video
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=10
RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
RABBITMQ_HEARTBEAT_SECONDS=60
RABBITMQ_RECONNECT_INTERVAL_SECONDS=5
RABBITMQ_API_USER=video-api
RABBITMQ_API_PASS=video-api-secret
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/${RABBITMQ_VHOST}
RABBITMQ_API_URL=amqp://guest:guest@127.0.0.1:5672/${RABBITMQ_VHOST}
# One account for the worker container (Outbox, download, import, report, canary).
RABBITMQ_WORKER_USER=video-worker
RABBITMQ_WORKER_PASS=video-worker-secret
RABBITMQ_DLQ_USER=video-dlq
RABBITMQ_DLQ_PASS=video-dlq-secret
RABBITMQ_DLQ_URL=amqp://guest:guest@127.0.0.1:5672/${RABBITMQ_VHOST}
REDIS_URL=redis://127.0.0.1:6379/0
DOWNLOAD_WORKER_THREADS=4
DOWNLOAD_QUEUED_RECOVERY_SECONDS=60

# 本地导入开关：视频与剧本文档上传默认开启，均可显式关闭。
# 关闭对应导入时，API 不允许创建新的上传任务。
MEDIA_IMPORT_ENABLED=true
DOCUMENT_IMPORT_ENABLED=true
# 仅填写逗号分隔的 exact origin（scheme://host[:port]）；禁止通配符和路径。
# 已有 MinIO 必须由其管理员在实例启动配置中应用此值；业务启动不会修改 MinIO。
MINIO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8101,http://localhost:8101

# MinIO 所有应用进程共用这一组 AK/SK；不要再增加按进程复制的凭据变量。
MINIO_ACCESS_KEY=video-access
MINIO_SECRET_KEY=video-secret-change-me
MINIO_BUCKET=video-artifacts
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_SECURE=false
# 可选：当 Web 在 API/MinIO 同一台开发机运行时，为浏览器单独签发回环地址。
# 原生 App 不发送 local-web 标识，仍使用上方可从手机访问的公共地址。
MINIO_LOCAL_BROWSER_ENDPOINT=127.0.0.1:9000
MINIO_LOCAL_BROWSER_SECURE=false

AUTH_JWT_SECRET=development-jwt-secret-change-me-32-bytes
AUTH_JWT_ISSUER=video-server
AUTH_JWT_AUDIENCE=video-web
AUTH_WEB_COOKIE_NAME=video_web_session
AUTH_WEB_IDLE_TTL_SECONDS=604800
AUTH_WEB_ABSOLUTE_TTL_SECONDS=2592000
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# This reserved account receives the administrator role only when registration
# also provides the X-Admin-Bootstrap-Secret header.
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_SECRET=development-admin-bootstrap-secret-change-me
REQUEST_FINGERPRINT_SECRET=development-fingerprint-secret-change-me
URL_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtdXJsLWtleS0zMi1ieXRlcyEhISE=

# Local (non-Compose) session Runner; Compose wires http://session-runner:19100.
# SESSION_RUNNER_BASE_URL=http://127.0.0.1:19101
RUNNER_HMAC_SECRET=development-runner-secret-change-me
RUNNER_EGRESS_PROXY=http://127.0.0.1:7897
# Provider overrides must name controlled proxy endpoints reachable from the
# local host; direct public proxy hostnames are intentionally unsupported.
RUNNER_PROVIDER_EGRESS_PROXIES={}
RUNNER_WORKSPACE_ROOT=../tmp/runner-work
RUNNER_MAX_ACTIVE_TASKS=4
# 内部长视频默认边界：24 小时、20 GiB 单文件、40 GiB 工作区、2 小时执行超时。
INSPECT_TIMEOUT_SECONDS=150
ARTICLE_DISCOVERY_TTL_SECONDS=900
ARTICLE_DISCOVERY_TIMEOUT_SECONDS=12
ARTICLE_DISCOVERY_MAX_RESPONSE_BYTES=4194304
ARTICLE_DISCOVERY_MAX_ITEMS=24
ARTICLE_DISCOVERY_MIN_INTERVAL_SECONDS=1
ARTICLE_DISCOVERY_PROXY_URL=http://127.0.0.1:7897
DOWNLOAD_TIMEOUT_SECONDS=7200
MAX_VIDEO_DURATION_SECONDS=86400
MAX_FILE_SIZE_BYTES=21474836480
RUNNER_DOWNLOAD_TIMEOUT_SECONDS=7200
RUNNER_INSPECT_TIMEOUT_SECONDS=120
RUNNER_MAX_DURATION_SECONDS=86400
RUNNER_MAX_OUTPUT_BYTES=21474836480
RUNNER_MAX_WORKSPACE_BYTES=42949672960
# YouTube uses a verified site session and the Compose-managed POT sidecar.
# Private canary targets. Use only project-owned or explicitly authorized URLs.
# Example shape: [{"target_id":"youtube-public-1","provider_key":"youtube","stage":"metadata","access_mode":"operator_managed","url":"https://www.youtube.com/watch?v=..."}]
PROVIDER_CANARY_TARGETS=[]
# Empty targets fall back to the fixed public samples; set false to disable.
PROVIDER_CANARY_DEFAULT_TARGETS=true
PROVIDER_VERIFIED_KEYS=[]
PEERTUBE_ALLOWED_INSTANCES=[]
PROVIDER_CANARY_METADATA_INTERVAL_SECONDS=21600
PROVIDER_CANARY_MEDIA_INTERVAL_SECONDS=86400
PROVIDER_CANARY_POLL_SECONDS=60
PROVIDER_AUTHORIZATION_QUEUE_ROOT=/run/provider-authorization
ANALYSIS_MAX_RUNS_PER_JOB=10
ANALYSIS_WORKER_HEARTBEAT_SECONDS=10
ANALYSIS_WORKER_STALE_SECONDS=45
ANALYSIS_MANUAL_RETRY_MIN_INTERVAL_SECONDS=30
ANALYSIS_MANUAL_RETRIES_PER_DAY=20
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_MAX_CONNECTIONS_PER_OWNER=4
WEBSOCKET_AUTH_RECHECK_SECONDS=15

# AI Worker 运行在宿主机；模型与线路由 Web Profile 管理。
# 这里只保留宿主机 CLI 二进制路径，未启用第三方 Profile 时固定使用 local-codex。
# 剧本分析还会受 ANALYSIS_ENABLED 总开关约束。
ANALYSIS_ENABLED=true
SCREENPLAY_ANALYSIS_ENABLED=true
ANALYSIS_CODEX_BINARY=codex
ANALYSIS_CLAUDE_BINARY=claude
ANALYSIS_CLAUDE_MAX_TURNS=40
ANALYSIS_FFMPEG_BINARY=ffmpeg
DOWNLOAD_THUMBNAIL_FFMPEG_BINARY=ffmpeg
DOWNLOAD_THUMBNAIL_TIMEOUT_SECONDS=15
DOWNLOAD_THUMBNAIL_MAX_BYTES=2000000
ANALYSIS_FFPROBE_BINARY=ffprobe
# 可选；默认使用系统临时目录。自定义路径必须位于 Git 仓库和 AGENTS.md 管辖目录之外。
# ANALYSIS_WORKSPACE_ROOT=/absolute/path/to/framefetch-analysis
ANALYSIS_MAX_SCREENPLAY_BYTES=2097152
ANALYSIS_SCREENPLAY_SINGLE_CALL_CHARACTERS=120000
ANALYSIS_SCREENPLAY_REWRITE_GLOSSARY_CHUNK_CHARACTERS=20000
ANALYSIS_SCREENPLAY_REWRITE_CHUNK_CHARACTERS=8000
ANALYSIS_MAX_SCREENPLAY_REWRITE_CHUNKS=128
ANALYSIS_SCREENPLAY_REWRITE_CONTEXT_CHARACTERS=1000
ANALYSIS_MAX_SCREENPLAY_REWRITE_OUTPUT_CHARACTERS=400000
ANALYSIS_SCREENPLAY_REWRITE_CHUNK_CALL_ATTEMPTS=2
ANALYSIS_SCREENPLAY_REWRITE_CHUNK_RETRY_DELAY_SECONDS=1
ANALYSIS_DATABASE_URL=postgresql+asyncpg://video:video@127.0.0.1:5432/video
ANALYSIS_MINIO_ENDPOINT=127.0.0.1:9000

# 首位管理员可由部署机交互命令 bootstrap_admin 初始化；其他用户注册需真实 SMTP。
# 注册邮箱验证码：启用前配置真实 SMTP；不支持固定验证码或跳过验证。
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=帧取

# Platform login state comes from your own Chrome, read live on each parse by
# the host agent: uv run python -m app.workers.session.chrome_agent install
# Pin a Chrome Profile per site only when several profiles are logged in.
# SITE_SESSION_SOURCE_SITES=["youtube.com","douyin.com"]
# SITE_SESSION_SOURCE_PROFILES={"youtube.com":"Default","douyin.com":"Default"}
# Independent HMAC secrets (>= 32 bytes) for Runner -> broker and broker -> host
# agent. Development Compose has placeholders; production Compose requires them.
# SITE_SESSION_RPC_SECRET=
# SITE_SESSION_AGENT_SECRET=

# Temporal uses separate databases on the existing PostgreSQL instance.
TEMPORAL_PORT=17233
TEMPORAL_ADDRESS=127.0.0.1:17233
TEMPORAL_NAMESPACE=framefetch
TEMPORAL_POSTGRES_USER=framefetch_temporal
# Generate once during installation; preserve across restarts.
TEMPORAL_POSTGRES_PASSWORD=
