{
  "manifest_version": 3,
  "name": "framefetch-identity",
  "version": "1.2.0",
  "description": "按任务提供平台身份，并自动准备视频号所需的元宝页面",
  "minimum_chrome_version": "120",
  "permissions": [
    "cookies",
    "alarms",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "帧取平台身份",
    "default_popup": "popup.html"
  },
  "key": ""
}
