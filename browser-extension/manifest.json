{
  "manifest_version": 3,
  "name": "帧取 Chrome 会话",
  "version": "1.0.0",
  "description": "按解析任务复用当前 Chrome 平台登录态",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "key": ""
}
