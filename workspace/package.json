{
  "name": "framefetch-server-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "description": "帧取工作区：content/ 是知识库与产品文稿，Nextra 渲染站点，管理员可用 Editor.js 在网页编辑",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 8131",
    "build": "next build --webpack",
    "check": "node scripts/check.mjs",
    "sync": "node scripts/sync-frontend.mjs",
    "sync:check": "node scripts/sync-frontend.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "start": "next start --hostname 127.0.0.1 --port 8130"
  },
  "dependencies": {
    "@editorjs/code": "^2.9.4",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.7",
    "@editorjs/header": "^2.8.9",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/table": "^2.4.6",
    "@phosphor-icons/react": "^2.1.10",
    "@theguild/remark-mermaid": "0.3.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "htmlparser2": "^12.0.0",
    "marked": "^18.0.14",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.11.1",
    "pagefind": "^1.5.2",
    "shadcn": "4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
