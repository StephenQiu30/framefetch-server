{
  "name": "video-server-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "description": "Next.js frontend for 帧取",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname 127.0.0.1 --port 8101",
    "lint": "pnpm biome:lint && pnpm typecheck",
    "biome:lint": "biome lint .",
    "format:check": "biome check . --linter-enabled=false",
    "openapi": "node node_modules/@umijs/openapi/dist/cli.js",
    "openapi:check": "pnpm openapi && git diff --exit-code -- src/api && test -z \"$(git ls-files --others --exclude-standard -- src/api)\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@editorjs/code": "^2.9.4",
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.7",
    "@editorjs/header": "^2.8.9",
    "@editorjs/inline-code": "^1.5.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/table": "^2.4.6",
    "@noble/hashes": "2.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^9.2.4",
    "@vidstack/react": "1.15.6",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "htmlparser2": "^12.0.0",
    "marked": "^18.0.14",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@umijs/openapi": "1.14.1",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.11.1",
    "shadcn": "4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
