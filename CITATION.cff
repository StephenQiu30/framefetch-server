repository-code: "https://github.com/StephenQiu30/framefetch-server"
license: MIT
keywords:
  - self-hosted
  - video-analysis
  - screenplay-analysis
  - media-processing
  - fastapi
  - nextjs
  - video-downloader
  - llm
